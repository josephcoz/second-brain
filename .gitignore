# A filled-in config at the repo root is real user data; the templates
# (config.example.yaml, sharing/config.yaml) are placeholders and DO ship.
/config.yaml

# Real values for the harness placeholders, and the expanded tree they
# produce. Both name a real employer and real paths. Only the .example
# template ships.
/scripts/harness-values.toml
/harness-filled/

# The real scrub ruleset necessarily spells out every string it removes —
# work email, internal tooling names, account handles. It lives in the private
# vault repo (Personal/harness-private/). Only the .example version ships.
/scripts/harness-scrub.toml
