<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLAUDE_CONTEXT</key>
		<string>work</string>
		<key>HOME</key>
		<string>{{home}}</string>
		<key>PATH</key>
		<string>{{home}}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.{{user_slug}}.second-brain.sdr-drip-verify</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{work_analyses_repo}}/.venv/bin/python</string>
		<string>{{work_analyses_repo}}/sdr_recycle_hex/verify_drip.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>{{work_automation_repo}}/logs/sdr-drip-verify.log</string>
	<key>StandardOutPath</key>
	<string>{{work_automation_repo}}/logs/sdr-drip-verify.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>{{work_analyses_repo}}</string>
</dict>
</plist>
